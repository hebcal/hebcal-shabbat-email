{
  "name": "hebcal-shabbat-email",
  "version": "4.3.3",
  "description": "Weekly shabbat times email subscription management for hebcal.com",
  "engines": {
    "node": ">= 24"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "clean": "rm -rf dist",
    "fix": "oxlint --fix . && prettier --write .",
    "format": "prettier --write .",
    "prepare": "npm run build",
    "pretest": "npm run typecheck",
    "compile": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hebcal/hebcal-shabbat-email.git"
  },
  "keywords": [
    "hebcal"
  ],
  "author": "Michael J. Radwin (https://github.com/hebcal)",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/hebcal/hebcal-shabbat-email/issues"
  },
  "homepage": "https://github.com/hebcal/hebcal-shabbat-email#readme",
  "devDependencies": {
    "@types/fs-ext": "^2.0.3",
    "@types/html-to-text": "^9.0.4",
    "@types/ini": "^4.1.1",
    "@types/node": "26.6.2",
    "@types/nodemailer-html-to-text": "^3.1.3",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1138.0",
    "@hebcal/core": "^6.9.3",
    "@hebcal/geo-sqlite": "^5.12.1",
    "@hebcal/hdate": "^0.22.8",
    "@hebcal/icalendar": "^7.0.4",
    "@hebcal/murmurhash3": "^1.0.0",
    "@hebcal/rest-api": "^7.1.3",
    "csv-parse": "^7.0.2",
    "dayjs": "^1.11.23",
    "fs-ext": "^2.1.1",
    "html-to-text": "^10.0.1",
    "ini": "^7.0.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.10",
    "nodemailer-html-to-text": "^3.2.0",
    "pino": "^10.3.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1"
  },
  "allowScripts": {
    "fs-ext": true
  }
}
